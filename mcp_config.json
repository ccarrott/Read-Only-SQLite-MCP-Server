{
  "mcpServers": {
    "sqlite-explorer": {
      "command": "python",
      "args": [
        "-m",
        "sqlite_mcp.server",
        "--db-path",
        "sample.db"
      ],
      "env": {
        "LOG_LEVEL": "INFO",
        "SQLITE_MAX_INSTRUCTIONS": "10000000",
        "SQLITE_MAX_VALUE_LENGTH": "10000000"
      }
    }
  }
}
